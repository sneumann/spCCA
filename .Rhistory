Y_Root <- as.matrix(read.xlsx("processed_Y_root.xlsx", rowNames = TRUE))
Y_Exud <- as.matrix(read.xlsx("processed_Y_Exud.xlsx", rowNames = TRUE))
sample_plan <- read_xlsx("RNAseqData/SamplePlan.xlsx")
sample_plan$Genotype <- gsub("GP-Fast", "GPFast", sample_plan$Genotype)
sample_plan['Replicate'] <- sapply(sample_plan['sname'], function(x) str_sub(x,-1,-1))
splan <- sample_plan[sample_plan$SampleID %in% rownames(X),,drop=FALSE]
# Design matrix for spCCA
splan$Genotype  <- relevel(factor(splan$Genotype), ref = "GPFast")
splan$Treatment <- relevel(factor(splan$Treatment), ref = "Control")
splan$Timepoint <- relevel(factor(splan$Timepoint), ref = "2dpi")
