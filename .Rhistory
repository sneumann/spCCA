n <- 1
CV <- read.delim(paste0('CCA3_yRoot_',n,'.txt'))
positive_genes <- rownames(CV)[
grepl("^HORVU", rownames(CV)) & CV[, 1] > 0
]
negative_genes <- rownames(CV)[
grepl("^HORVU", rownames(CV)) & CV[, 1] < 0
]
positive_metabs <- rownames(CV)[!is.na(suppressWarnings(as.numeric(rownames(CV)))) & CV[, 1] > 0]
negative_metabs <- rownames(CV)[!is.na(suppressWarnings(as.numeric(rownames(CV)))) & CV[, 1] < 0]
length(positive_genes)
length(negative_genes)
length(positive_metabs)
length(negative_metabs)
saveRDS(CCA3_Root,"CCA3_Root_newSPCCA.rds")
