# Check testthat.R for embedded nulls or encoding issues (no modifications)
file_path <- "tests/testthat.R"
try({
# Read raw bytes without interpreting them
raw_bytes <- readBin(file_path, what = "raw", n = file.info(file_path)$size)
# Detect embedded nulls
has_nul <- any(raw_bytes == as.raw(0x00))
# Try reading as UTF-8 to detect decode errors
text <- rawToChar(raw_bytes, multiple = TRUE)
converted <- iconv(text, from = "", to = "UTF-8", sub = NA)
has_bad_encoding <- any(is.na(converted))
# Report findings
if (!has_nul && !has_bad_encoding) {
message("OK: No embedded nulls or encoding problems detected.")
} else {
if (has_nul) message("Warning: Embedded null bytes detected.")
if (has_bad_encoding) message("Warning: Invalid or non‑UTF‑8 encoding detected.")
}
}, silent = FALSE)
