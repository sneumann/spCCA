find_nulls <- function(path) {
files <- list.files(path, recursive = TRUE, full.names = TRUE)
bad <- character()
for (f in files) {
if (file.info(f)$isdir) next
x <- readBin(f, what = "raw", n = file.info(f)$size)
if (any(x == as.raw(0))) bad <- c(bad, f)
}
bad
}
