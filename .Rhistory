library(readxl)
library(dplyr)
library(stringr)
library(tidyr)
library(edgeR)
library(limma)
library(matrixStats)
library(ggplot2)
library(reshape2)
library(pheatmap)
library(ggpubr)
library(DESeq2)
library(openxlsx)
X <- as.matrix(read.xlsx("processed_X.xlsx", rowNames = TRUE))
Y_Root <- as.matrix(read.xlsx("processed_Y_root.xlsx", rowNames = TRUE))
Y_Exud <- as.matrix(read.xlsx("processed_Y_Exud.xlsx", rowNames = TRUE))
sample_plan <- read_xlsx("RNAseqData/SamplePlan.xlsx")
sample_plan$Genotype <- gsub("GP-Fast", "GPFast", sample_plan$Genotype)
sample_plan['Replicate'] <- sapply(sample_plan['sname'], function(x) str_sub(x,-1,-1))
splan <- sample_plan[sample_plan$SampleID %in% rownames(X),,drop=FALSE]
# Design matrix for spCCA
splan$Genotype  <- relevel(factor(splan$Genotype), ref = "GPFast")
splan$Treatment <- relevel(factor(splan$Treatment), ref = "Control")
splan$Timepoint <- relevel(factor(splan$Timepoint), ref = "2dpi")
splan$Replicate <- factor(splan$Replicate)
Z <- model.matrix(
~ Genotype + Treatment + Timepoint + Replicate,
data = splan
)
Z <- Z[,2:ncol(Z)]
dim(Z)
det(var(Z)) # Determinant of the covariance matrix determines whether columns of Z are linearly independent. Value extremely close to 0 indicates this is a singular covariance matrix, which means the matrix is not invertible. This is taken care by spCCA by converting it into a pseudo inverse
apply(Z, 2, var)  # a column with zero variance must be removed
qr(Z)$rank
