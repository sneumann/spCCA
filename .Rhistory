result_summary <- function(W_list){
summary_list <- lapply(W_list, function(W) {
list(
pos_per_cv = colSums(W > 0),
neg_per_cv = colSums(W < 0),
nonzero_per_cv = colSums(W != 0),
pos_per_feature = rowSums(W > 0),
neg_per_feature = rowSums(W < 0),
nonzero_per_feature = rowSums(W != 0)
)
})
df_list <- lapply(names(summary_list), function(dname) {
s <- summary_list[[dname]]
print(rep(dname,length(s$pos_per_cv)))
print(s$total_per_cv)
data.frame(
dataset = rep(dname,length(s$pos_per_cv)),
CV = seq_along(s$pos_per_cv),
pos = s$pos_per_cv,
neg = s$neg_per_cv,
total = s$nonzero_per_cv
)
})
df_long <- bind_rows(df_list)
feature_df <- lapply(names(summary_list), function(dname) {
s <- summary_list[[dname]]
data.frame(
dataset = dname,
pos_features = s$pos_per_feature,
neg_features = s$neg_per_feature,
total_features = s$nonzero_per_feature
)
})
feature_df <- bind_rows(feature_df)
return(list(featureCount_per_CV = df_long, featurelevel_summary = feature_df))
}
