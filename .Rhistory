)
Z <- Z[,2:ncol(Z)]
dim(Z)
det(var(Z)) # Determinant of the covariance matrix determines whether columns of Z are linearly independent. Value extremely close to 0 indicates this is a singular covariance matrix, which means the matrix is not invertible. This is taken care by spCCA by converting it into a pseudo inverse
apply(Z, 2, var)  # a column with zero variance must be removed
qr(Z)$rank
